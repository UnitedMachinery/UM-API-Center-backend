# Platform MySQL 8 configuration. Do not commit real values.
PLATFORM_DB_URL=jdbc:mysql://127.0.0.1:3306/um_api_center?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
PLATFORM_DB_USERNAME=um_api_center
PLATFORM_DB_PASSWORD=replace_me

# 32-byte AES-GCM key encoded with Base64. Required starting with module 2.
DATASOURCE_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key

# Trusted reverse proxy configuration must be finalized before public release.
SERVER_PORT=8080
